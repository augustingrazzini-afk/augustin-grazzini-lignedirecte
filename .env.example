# --- Obligatoire ---
DATABASE_URL="postgresql://cockpit:cockpit@localhost:5432/cockpit"
# URL publique de l'app (liens des emails, webhooks)
APP_URL="http://localhost:3000"
APP_NAME="LigneDirecte Cockpit"
# 32+ caractères aléatoires : signe les sessions (openssl rand -base64 48)
AUTH_SECRET=""
# 32 octets en base64 : chiffre les clés API des intégrations (openssl rand -base64 32)
ENCRYPTION_KEY=""
# Protège l'appel de synchro planifié (Vercel Cron envoie "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=""

# --- Emails de connexion (Resend). Vide = lien affiché dans les logs serveur (dev uniquement) ---
RESEND_API_KEY=""
EMAIL_FROM="Cockpit <connexion@exemple.fr>"

# --- IA (API Claude) ---
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5-5"

# --- Paiement (Stripe) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_SOLO=""
STRIPE_PRICE_AGENCY=""

# --- Stockage des enregistrements (S3 compatible : Cloudflare R2, Supabase, AWS) ---
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Minari : URL de l'API (à confirmer dans Minari > Settings > API & webhook) ---
MINARI_API_BASE="https://api.minari.ai/v1"

// Cockpit — reporting d'appels multi-outils pour SDR et agences de prospection.
// Isolation : chaque donnée appartient à une Organization (le SDR / l'agence).
// Un Client (le client du SDR) ne voit que les appels où Call.clientId = son id.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  name            String?
  passwordHash    String? // scrypt ; null = connexion par lien email uniquement
  emailVerifiedAt DateTime? // adresse confirmée (lien cliqué)
  failedLogins    Int       @default(0)
  lockedUntil     DateTime? // blocage temporaire après trop d'essais ratés
  termsAcceptedAt DateTime? // acceptation des conditions générales à l'inscription
  termsVersion    String? // version acceptée (date de mise à jour des conditions)
  sessionVersion  Int       @default(0) // augmente à chaque déconnexion ou changement de mot de passe : révoque les sessions
  createdAt    DateTime       @default(now())
  memberships  Membership[]
  clientAccess ClientMember[]
}

model LoginToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  redirect  String?
  purpose   String    @default("login") // login | verify (inscription) | reset (mot de passe oublié)
  payload   String? // inscription : mot de passe chiffré en attente de confirmation
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

model Organization {
  id                   String        @id @default(cuid())
  name                 String
  plan                 String        @default("trial") // trial | solo | agency
  subscriptionStatus   String        @default("trialing") // trialing | active | past_due | canceled
  seats                Int           @default(1) // formule Équipe : nombre de commerciaux payés
  trialEndsAt          DateTime
  stripeCustomerId     String?       @unique
  stripeSubscriptionId String?       @unique
  offer                String        @default("")
  slackWebhook         String? // alertes de relance dans Slack
  cancelRequestedAt    DateTime? // résiliation demandée en un clic (paiement par liens Stripe)
  endedAt              DateTime? // fin de contrat (abonnement résilié) : les données sont supprimées 30 jours après
  purgedAt             DateTime? // données de prospection supprimées (fin de contrat + 30 jours)
  createdAt            DateTime      @default(now())
  members              Membership[]
  clients              Client[]
  integrations         Integration[]
  calls                Call[]
  rules                ClientRule[]
  briefs               Brief[]
  coaches              Coach[]
  activities           Activity[]
  tasks                Task[]
}

model Membership {
  id        String       @id @default(cuid())
  orgId     String
  userId    String
  role      String       @default("owner") // owner | member
  digest    Boolean      @default(true) // récap des relances chaque matin
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
}

/** Un commercial suivi par la boîte (interne, freelance ou agence). Nom technique historique : Client. */
model Client {
  id           String         @id @default(cuid())
  orgId        String
  name         String
  kind         String         @default("interne") // interne | freelance | agence
  agency       String         @default("") // société du freelance / de l'agence
  offer        String         @default("")
  slackWebhook String?
  shareToken   String?        @unique // lien de suivi en direct, lisible sans compte ; null = désactivé
  createdAt    DateTime       @default(now())
  org          Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members      ClientMember[]
  activities   Activity[]
  tasks        Task[]
  rules        ClientRule[]
  calls        Call[]
  sharedCalls  CallShare[]
  integrations Integration[]

  @@index([orgId])
}

model ClientMember {
  id        String   @id @default(cuid())
  clientId  String
  userId    String
  digest    Boolean  @default(true)
  joinedAt    DateTime? // première visite de son espace (lien d'invitation cliqué)
  onboardedAt DateTime? // guide de démarrage terminé
  createdAt DateTime @default(now())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clientId, userId])
}

model Integration {
  id           String       @id @default(cuid())
  orgId        String
  clientId     String? // intégration connectée par un client : ses appels lui reviennent d'office
  provider     String // minari | aircall | ringover | lemlist | hubspot | instantly | smartlead | webhook
  label        String
  credentials  String // chiffré (AES-256-GCM)
  settings     Json         @default("{}")
  webhookToken String       @unique
  status       String       @default("active") // active | error | paused
  lastSyncAt   DateTime?
  lastError    String?
  createdAt    DateTime     @default(now())
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  calls        Call[]
  activities   Activity[]

  @@index([orgId])
}

// Range automatiquement un appel chez un client : ex. liste Minari "Nova" -> client Nova.
model ClientRule {
  id        String       @id @default(cuid())
  orgId     String
  clientId  String
  provider  String? // null = toutes les sources
  field     String // rep | list | campaign | tag | number | company
  value     String
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client    Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model Call {
  id            String       @id @default(cuid())
  orgId         String
  clientId      String?
  integrationId String?
  provider      String // minari | aircall | ringover | lemlist | hubspot | csv | manual
  externalId    String
  kind          String       @default("call") // call | meeting (RDV mené par un AE)
  startedAt     DateTime
  durationSec   Int          @default(0)
  direction     String? // inbound | outbound
  status        String       @default("connected")
  connected     Boolean      @default(false)
  meetingBooked Boolean      @default(false)
  firstName     String       @default("")
  lastName      String       @default("")
  company       String       @default("")
  jobTitle      String       @default("")
  contactKey    String       @default("")
  repName       String       @default("")
  listName      String       @default("")
  campaign      String       @default("")
  tags          String[]     @default([])
  phoneLast4    String       @default("")
  contactSealed String? // téléphone et email du prospect, chiffrés (AES-256) : { phone, email }
  summary       String       @default("")
  aiSummary     String       @default("") // analyse rédigée par l'IA de Trustpipe (le résumé de l'outil d'appel reste dans summary)
  aiAnalyzedAt  DateTime?
  optOut        Boolean      @default(false) // le prospect a demandé à ne plus être contacté : plus aucune relance
  aiMeeting     Boolean      @default(false) // l'IA pense qu'un RDV a été fixé : à confirmer, ne compte pas dans les chiffres
  objections    String[]     @default([])
  objDetails    Json         @default("[]")
  transcript    Json         @default("[]")
  recordingUrl  String?
  recordingKey  String? // fichier stocké chez nous (S3/R2)
  aiStatus      String       @default("none") // none | pending | done | failed
  transcriptStatus String    @default("none") // none | pending | done | failed : transcription faite par Trustpipe
  transcriptJob String? // identifiant de la transcription en cours chez le service de transcription
  syncHash      String? // empreinte de la dernière version reçue de l'outil : un appel inchangé n'est pas réécrit
  debrief       Json? // débrief IA d'un rendez-vous (kind = meeting)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client        Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  shares        CallShare[]
  integration   Integration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  @@unique([orgId, provider, externalId])
  @@index([orgId, startedAt])
  @@index([clientId, startedAt])
  @@index([orgId, aiStatus])
  @@index([transcriptStatus])
}

model Brief {
  id          String       @id @default(cuid())
  orgId       String
  clientId    String?
  query       String
  prospect    String
  company     String       @default("")
  content     Json
  createdById String
  status      String       @default("done") // pending (rédaction en cours, même page fermée) | done | failed
  error       String       @default("")
  createdAt   DateTime     @default(now())
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, clientId, createdAt])
}

model Coach {
  id        String       @id @default(cuid())
  orgId     String
  clientId  String?
  days      Int
  content   Json
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, clientId, createdAt])
}

// Événement de prospection écrite : email ou LinkedIn (les appels restent dans Call).
model Activity {
  id            String       @id @default(cuid())
  orgId         String
  clientId      String?
  integrationId String?
  provider      String // lemlist | instantly | smartlead | hubspot | webhook | csv | manual
  externalId    String
  channel       String // email | linkedin
  type          String // sent | opened | clicked | replied | bounced | unsubscribed | invite_sent | invite_accepted | message_sent | profile_visit | meeting_booked
  occurredAt    DateTime
  firstName     String       @default("")
  lastName      String       @default("")
  company       String       @default("")
  jobTitle      String       @default("")
  contactKey    String       @default("")
  repName       String       @default("")
  campaign      String       @default("")
  step          Int?
  subject       String       @default("")
  body          String       @default("")
  sentiment     String? // positive | neutral | negative | ooo | objection
  objections    String[]     @default([])
  aiStatus      String       @default("none") // none | pending | done | failed
  createdAt     DateTime     @default(now())
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client        Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  integration   Integration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  @@unique([orgId, provider, externalId])
  @@index([orgId, occurredAt])
  @@index([clientId, occurredAt])
  @@index([orgId, contactKey])
  @@index([orgId, aiStatus])
}

// Relance à faire, avec échéance. Créée par l'IA, par une règle ou à la main.
model Task {
  id          String       @id @default(cuid())
  orgId       String
  clientId    String?
  contactKey  String
  contactName String       @default("")
  company     String       @default("")
  channel     String // call | email | linkedin
  dueAt       DateTime
  reason      String
  suggestion  String       @default("")
  status      String       @default("open") // open | done | dismissed
  source      String // ai | rule | manual
  sourceKind  String // call | activity | rule | manual
  sourceId    String
  doneAt      DateTime?
  doneById    String?
  createdAt   DateTime     @default(now())
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client      Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@unique([orgId, sourceKind, sourceId])
  @@index([orgId, status, dueAt])
  @@index([clientId, status, dueAt])
}

/// Avis laissés depuis l'app (case « Votre avis » du widget).
model Feedback {
  id        String   @id @default(cuid())
  userId    String?
  email     String?
  orgId     String?
  clientId  String?
  rating    Int? // 1 à 5
  message   String
  page      String?
  handledAt   DateTime? // avis traité (correction mise en ligne, réponse préparée ou rien à faire)
  handledNote String? // ce qui a été fait
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}

/// Compteur journalier d'appels à l'IA (ex. questions posées au chatbot via un lien de suivi).
model AiUsage {
  key   String
  day   String // AAAA-MM-JJ
  count Int    @default(0)

  @@id([key, day])
}

/// Identifiant client OAuth de Trustpipe auprès d'un outil (connexion en un clic via MCP), enregistré une seule fois.
model OAuthClient {
  id           String   @id @default(cuid())
  issuer       String
  redirectUri  String
  clientId     String
  clientSecret String?
  createdAt    DateTime @default(now())

  @@unique([issuer, redirectUri])
}

/// Réglages techniques chiffrés créés automatiquement (ex. secret du webhook Stripe, propre à chaque compte Stripe).
model AppSecret {
  key       String   @id
  value     String // chiffré (AES-256-GCM)
  updatedAt DateTime @updatedAt
}

/// Conversations de l'assistant (historique), propres à chaque personne (ou à chaque lien de suivi) et à chaque espace.
model Conversation {
  id        String   @id @default(cuid())
  orgId     String
  owner     String // utilisateur, ou « share:<clientId> » pour un lien de suivi
  clientId  String?
  title     String
  messages  Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([owner, orgId, clientId, updatedAt])
}

/// Connecteur Claude (MCP) : applications enregistrées automatiquement (enregistrement dynamique OAuth).
model McpClient {
  id           String   @id // client_id public
  name         String   @default("")
  redirectUris String[]
  createdAt    DateTime @default(now())
}

/// Code d'autorisation OAuth, à usage unique, valable 10 minutes (stocké haché, avec le défi PKCE).
model McpCode {
  codeHash    String    @id
  clientId    String
  userId      String
  orgId       String
  redirectUri String
  challenge   String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
}

/// Jetons d'accès du connecteur (hachés). L'accès est limité à l'organisation de l'utilisateur qui a autorisé.
model McpToken {
  id               String    @id @default(cuid())
  tokenHash        String    @unique
  refreshHash      String    @unique
  clientId         String
  clientName       String    @default("")
  userId           String
  orgId            String
  expiresAt        DateTime
  refreshExpiresAt DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@index([orgId])
}

/** Erreurs serveur (suivi maison) : consultables depuis la page de l'éditeur, purgées après 30 jours. */
model ErrorLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  path      String
  method    String   @default("")
  message   String
  digest    String   @default("")

  @@index([createdAt])
}

/// Un appel envoyé à un autre commercial (« écoute celui-ci, il est bon ») : il le voit dans son espace sans que l'attribution change.
model CallShare {
  id        String   @id @default(cuid())
  callId    String
  clientId  String // le commercial qui reçoit l'appel
  fromName  String   @default("")
  note      String   @default("")
  createdAt DateTime @default(now())
  call      Call     @relation(fields: [callId], references: [id], onDelete: Cascade)
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([callId, clientId])
  @@index([clientId, createdAt])
}

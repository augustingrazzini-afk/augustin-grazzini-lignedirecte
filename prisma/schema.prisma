// Cockpit — reporting d'appels multi-outils pour SDR et agences de prospection.
// Isolation : chaque donnée appartient à une Organization (le SDR / l'agence).
// Un Client (le client du SDR) ne voit que les appels où Call.clientId = son id.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  name            String?
  passwordHash    String? // scrypt ; null = connexion par lien email uniquement
  emailVerifiedAt DateTime? // adresse confirmée (lien cliqué)
  failedLogins    Int       @default(0)
  lockedUntil     DateTime? // blocage temporaire après trop d'essais ratés
  createdAt    DateTime       @default(now())
  memberships  Membership[]
  clientAccess ClientMember[]
}

model LoginToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  redirect  String?
  purpose   String    @default("login") // login | verify (inscription) | reset (mot de passe oublié)
  payload   String? // inscription : mot de passe chiffré en attente de confirmation
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

model Organization {
  id                   String        @id @default(cuid())
  name                 String
  plan                 String        @default("trial") // trial | solo | agency
  subscriptionStatus   String        @default("trialing") // trialing | active | past_due | canceled
  trialEndsAt          DateTime
  stripeCustomerId     String?       @unique
  stripeSubscriptionId String?       @unique
  offer                String        @default("")
  slackWebhook         String? // alertes de relance dans Slack
  createdAt            DateTime      @default(now())
  members              Membership[]
  clients              Client[]
  integrations         Integration[]
  calls                Call[]
  rules                ClientRule[]
  briefs               Brief[]
  coaches              Coach[]
  activities           Activity[]
  tasks                Task[]
}

model Membership {
  id        String       @id @default(cuid())
  orgId     String
  userId    String
  role      String       @default("owner") // owner | member
  digest    Boolean      @default(true) // récap des relances chaque matin
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
}

model Client {
  id           String         @id @default(cuid())
  orgId        String
  name         String
  offer        String         @default("")
  slackWebhook String?
  shareToken   String?        @unique // lien de suivi en direct, lisible sans compte ; null = désactivé
  createdAt    DateTime       @default(now())
  org          Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members      ClientMember[]
  activities   Activity[]
  tasks        Task[]
  rules        ClientRule[]
  calls        Call[]
  integrations Integration[]

  @@index([orgId])
}

model ClientMember {
  id        String   @id @default(cuid())
  clientId  String
  userId    String
  digest    Boolean  @default(true)
  createdAt DateTime @default(now())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clientId, userId])
}

model Integration {
  id           String       @id @default(cuid())
  orgId        String
  clientId     String? // intégration connectée par un client : ses appels lui reviennent d'office
  provider     String // minari | aircall | ringover | lemlist | hubspot | instantly | smartlead | webhook
  label        String
  credentials  String // chiffré (AES-256-GCM)
  settings     Json         @default("{}")
  webhookToken String       @unique
  status       String       @default("active") // active | error | paused
  lastSyncAt   DateTime?
  lastError    String?
  createdAt    DateTime     @default(now())
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  calls        Call[]
  activities   Activity[]

  @@index([orgId])
}

// Range automatiquement un appel chez un client : ex. liste Minari "Smoteo" -> client Smoteo.
model ClientRule {
  id        String       @id @default(cuid())
  orgId     String
  clientId  String
  provider  String? // null = toutes les sources
  field     String // list | campaign | tag | number | company
  value     String
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client    Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model Call {
  id            String       @id @default(cuid())
  orgId         String
  clientId      String?
  integrationId String?
  provider      String // minari | aircall | ringover | lemlist | hubspot | csv | manual
  externalId    String
  kind          String       @default("call") // call | meeting (RDV mené par un AE)
  startedAt     DateTime
  durationSec   Int          @default(0)
  direction     String? // inbound | outbound
  status        String       @default("connected")
  connected     Boolean      @default(false)
  meetingBooked Boolean      @default(false)
  firstName     String       @default("")
  lastName      String       @default("")
  company       String       @default("")
  jobTitle      String       @default("")
  contactKey    String       @default("")
  repName       String       @default("")
  listName      String       @default("")
  campaign      String       @default("")
  tags          String[]     @default([])
  phoneLast4    String       @default("")
  summary       String       @default("")
  objections    String[]     @default([])
  objDetails    Json         @default("[]")
  transcript    Json         @default("[]")
  recordingUrl  String?
  recordingKey  String? // fichier stocké chez nous (S3/R2)
  aiStatus      String       @default("none") // none | pending | done | failed
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client        Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  integration   Integration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  @@unique([orgId, provider, externalId])
  @@index([orgId, startedAt])
  @@index([clientId, startedAt])
  @@index([orgId, aiStatus])
}

model Brief {
  id          String       @id @default(cuid())
  orgId       String
  clientId    String?
  query       String
  prospect    String
  company     String       @default("")
  content     Json
  createdById String
  createdAt   DateTime     @default(now())
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, clientId, createdAt])
}

model Coach {
  id        String       @id @default(cuid())
  orgId     String
  clientId  String?
  days      Int
  content   Json
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, clientId, createdAt])
}

// Événement de prospection écrite : email ou LinkedIn (les appels restent dans Call).
model Activity {
  id            String       @id @default(cuid())
  orgId         String
  clientId      String?
  integrationId String?
  provider      String // lemlist | instantly | smartlead | hubspot | webhook | csv | manual
  externalId    String
  channel       String // email | linkedin
  type          String // sent | opened | clicked | replied | bounced | unsubscribed | invite_sent | invite_accepted | message_sent | profile_visit | meeting_booked
  occurredAt    DateTime
  firstName     String       @default("")
  lastName      String       @default("")
  company       String       @default("")
  jobTitle      String       @default("")
  contactKey    String       @default("")
  repName       String       @default("")
  campaign      String       @default("")
  step          Int?
  subject       String       @default("")
  body          String       @default("")
  sentiment     String? // positive | neutral | negative | ooo | objection
  objections    String[]     @default([])
  aiStatus      String       @default("none") // none | pending | done | failed
  createdAt     DateTime     @default(now())
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client        Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  integration   Integration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  @@unique([orgId, provider, externalId])
  @@index([orgId, occurredAt])
  @@index([clientId, occurredAt])
  @@index([orgId, contactKey])
  @@index([orgId, aiStatus])
}

// Relance à faire, avec échéance. Créée par l'IA, par une règle ou à la main.
model Task {
  id          String       @id @default(cuid())
  orgId       String
  clientId    String?
  contactKey  String
  contactName String       @default("")
  company     String       @default("")
  channel     String // call | email | linkedin
  dueAt       DateTime
  reason      String
  suggestion  String       @default("")
  status      String       @default("open") // open | done | dismissed
  source      String // ai | rule | manual
  sourceKind  String // call | activity | rule | manual
  sourceId    String
  doneAt      DateTime?
  doneById    String?
  createdAt   DateTime     @default(now())
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client      Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@unique([orgId, sourceKind, sourceId])
  @@index([orgId, status, dueAt])
  @@index([clientId, status, dueAt])
}
